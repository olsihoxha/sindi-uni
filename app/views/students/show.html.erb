<% content_for :title, @student.full_name %>
<%= link_to "Back to students", students_path, class: "back-link" %>
<div class="page-heading">
<div>
<p class="eyebrow">STUDENT PROFILE / ID <%= @student.id %>
</p>
<h1>
<%= @student.full_name %>
</h1>
<p class="muted">
<%= @student.email %>
</p>
</div>
<%= link_to "Edit student", edit_student_path(@student), class: "button secondary" %>
</div>
<h2>Course enrollments</h2>
<div class="table-wrap">
<table>
<thead>
<tr>
<th>Course</th>
<th>Semester</th>
<th>Overall grade</th>
<th>Actions</th>
</tr>
</thead>
<tbody>
<% @enrollments.each do |enrollment| %>
<tr>
<td>
<%= enrollment.course.code %> · <%= enrollment.course.name %>
</td>
<td>
<%= enrollment.course.semester %>
</td>
<td>
<%= grade_label(GradeSummary.call(enrollment)) %>
</td>
<td>
<%= link_to "Manage grades", course_enrollment_grades_path(enrollment.course, enrollment) %>
</td>
</tr>
<% end %>
<% if @enrollments.empty? %>
<tr>
<td colspan="4">Not enrolled yet. Add this student from a course's class roster.</td>
</tr>
<% end %>
</tbody>
</table>
</div>
<div class="danger-zone">
<p>Deleting a student also removes their enrollments and grades.</p>
<%= button_to "Delete student", student_path(@student), method: :delete, class: "button danger-button", form: { data: { confirm: "Permanently delete this student and their grades?" } } %>
</div>
