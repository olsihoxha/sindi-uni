<% content_for :title, "My profile" %>
<div class="page-heading">
<div>
<p class="eyebrow">ACCOUNT SETTINGS</p>
<h1>Personal information</h1>
</div>
</div>
<%= render "shared/errors", record: @user %>
<%= form_with model: @user, url: profile_path, method: :patch, class: "stack-form panel form-panel" do |form| %>
<%= render "shared/user_fields", form: form %>
<%= form.submit "Save profile", class: "button" %>
<% end %>
